{
  "name": "meyaudioplayer",
  "productName": "MeyAudioPlayer",
  "version": "1.0.0",
  "description": "MeyAudioPlayer (MAP) - music & audio player",
  "author": "Kamil",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kamil.meyaudioplayer",
    "productName": "MeyAudioPlayer",
    "copyright": "Copyright © 2026 Kamil",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "app/**/*", "build/icon.png"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico",
      "legalTrademarks": "MeyAudioPlayer by Kamil"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MeyAudioPlayer",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "LICENSE.txt",
      "artifactName": "MeyAudioPlayer-Setup-${version}.exe"
    },
    "portable": { "artifactName": "MeyAudioPlayer-${version}-portable.exe" },
    "fileAssociations": [
      { "ext": ["mp3", "m4a", "aac", "wav", "ogg", "opus", "flac"], "name": "Audio file", "description": "Audio file", "role": "Viewer", "icon": "build/icon.ico" }
    ]
  }
}
